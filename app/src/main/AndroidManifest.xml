<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- NFC is needed to check in and to write tags, but the app still installs and explains
         the limitation on devices without it. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Visitor logs are personal data: keep them out of cloud backups and device transfers
         (dataExtractionRules on Android 12+, allowBackup and fullBackupContent before). -->
    <application
        android:name=".CvPassApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_main"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_main_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CvPass">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Tapping a CV-PASS venue tag while the app is not in the foreground opens check-in. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.jumincho.cvpass.venue" />
            </intent-filter>
        </activity>
    </application>

</manifest>
